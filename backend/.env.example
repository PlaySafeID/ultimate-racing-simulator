# The OAuth client PlaySafe ID issued you. The secret never leaves this backend.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# An API key from the Partner Portal, PLATFORM kind, with READ. Used for the live
# status lookup.
PLAYSAFE_API_KEY=

# Signs session tokens. Any long random string. Changing it signs everyone out.
SESSION_SECRET=

# Shared with the game server. Not the PlaySafe ID API key: the game server never
# talks to PlaySafe ID and should not hold a credential for it.
GAME_SERVER_KEY=

# Where a browser reaches this backend. PUBLIC_BASE_URL + /playsafe/callback must
# be registered on the OAuth client as an allowed callback. Behind a tunnel, set
# this to the public address. On loopback the game offers no QR code for signing
# in on a phone, since the phone could not reach it.
PUBLIC_BASE_URL=http://localhost:8080

# Where the game client is served from, for CORS.
ALLOWED_ORIGIN=http://localhost:8000

# What an admitted client is told to connect to, scheme included. A page served
# over HTTPS needs wss:// here.
GAME_SERVER_URL=ws://localhost:8211

# demo or public. Demo offers preset accounts and a status badge; public offers
# only PlaySafe ID sign-in.
ENVIRONMENT=public

# Where a player goes to finish or repair their verification (UNVERIFIED, REAUTH).
# Left empty, the game offers no button.
PLAYSAFE_PORTAL_URL=https://app.playsafeid.com

# Defaults point at production. There is no sandbox tenant.
PLAYSAFE_ISSUER=https://auth.playsafeid.com
PLAYSAFE_API_BASE=https://api.playsafeid.com/v2

# Hard ceiling on a session, in seconds. 0 means none. Defaults to 0 in demo and
# 3600 in public. The clock restarts when a player joins a world.
# SESSION_SECONDS=0

# How long a ticket stays redeemable, and so how long it holds a slot.
# TICKET_SECONDS=60

# Players per world.
# WORLD_CAPACITY=10
